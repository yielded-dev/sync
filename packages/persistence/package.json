{
  "name": "@yielded/sync-persistence",
  "version": "0.1.0-beta.2",
  "description": "Optional IndexedDB and Expo SQLite persistence for Effect Sync clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/sync.git",
    "directory": "packages/persistence"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./indexeddb": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    },
    "./expo": {
      "types": "./dist/expo.d.mts",
      "import": "./dist/expo.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check --strict",
    "test": "vp test"
  },
  "dependencies": {
    "@yielded/sync": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-sqlite": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "expo-sqlite": "catalog:"
  },
  "peerDependenciesMeta": {
    "expo-sqlite": {
      "optional": true
    }
  }
}
