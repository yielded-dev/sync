{
  "name": "@yielded/sync-local-indexeddb",
  "version": "0.1.0-beta.5",
  "description": "IndexedDB local persistence for Effect Sync clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/sync.git",
    "directory": "packages/local-indexeddb"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./IndexedDb": {
      "types": "./dist/IndexedDb.d.mts",
      "import": "./dist/IndexedDb.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check --strict",
    "test": "vp test"
  },
  "dependencies": {
    "@yielded/sync": "workspace:*",
    "@yielded/sync-persistence": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
