{
  "name": "yielded-sync-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript && vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "effect-tsgo patch --typescript",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && vp run -r typecheck",
    "check": "vp check && vp run typecheck",
    "test": "vp run -r --concurrency-limit 4 test",
    "build": "vp run -r build",
    "docs:dev": "vp run @yielded/sync-docs#dev",
    "docs:build": "vp run @yielded/sync-docs#build",
    "docs:preview": "vp run @yielded/sync-docs#preview",
    "docs:deploy": "vp run docs:build && vp exec wrangler deploy --config site/wrangler.jsonc",
    "ready": "vp run build && vp run check && vp run test && vp run release:check",
    "changeset": "changeset",
    "changeset:pre": "changeset pre",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@effect/atom-react": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "@effect/tsgo": "0.48.1",
    "@types/node": "26.1.2",
    "effect": "4.0.0",
    "effect-cf": "0.53.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "4.133.0",
    "expo-sqlite": "57.0.3",
    "playwright": "1.58.2",
    "expo": "57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@astrojs/starlight": "0.42.4",
    "astro": "7.3.5",
    "starlight-links-validator": "0.26.0",
    "@yielded/starlight-theme": "0.2.1",
    "alchemy": "2.0.0-beta.80",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "vitest": "5.0.3"
  }
}
