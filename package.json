{
  "name": "yielded-sync-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript && vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "effect-tsgo patch --typescript",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && vp run -r typecheck",
    "check": "vp check && vp run typecheck",
    "test": "vp run -r --concurrency-limit 4 test",
    "build": "vp run -r build",
    "docs:dev": "vp run @yielded/sync-docs#dev",
    "docs:build": "vp run @yielded/sync-docs#build",
    "docs:preview": "vp run @yielded/sync-docs#preview",
    "docs:deploy": "vp run docs:build && vp exec wrangler deploy --config site/wrangler.jsonc",
    "ready": "vp run build && vp run check && vp run test && vp run release:check",
    "release:check": "node scripts/release-check.mjs",
    "changeset": "changeset",
    "changeset:pre": "changeset pre",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@effect/tsgo": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260825.1",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "26.1.2",
    "effect": "4.0.0-rc.112",
    "effect-cf": "0.42.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "wrangler": "4.133.0",
    "expo-sqlite": "57.0.3",
    "playwright": "1.58.2",
    "expo": "57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@types/react": "19.2.14",
    "@astrojs/starlight": "0.42.4",
    "astro": "7.3.5",
    "starlight-links-validator": "0.26.0",
    "@yielded/starlight-theme": "0.1.0"
  }
}
