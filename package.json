{
  "name": "yielded-sync-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript && vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "effect-tsgo patch --typescript",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && vp run -r typecheck",
    "check": "vp check && vp run typecheck",
    "test": "vp run -r --concurrency-limit 4 test",
    "build": "vp run -r build",
    "docs:dev": "vp run @yielded/sync-docs#dev",
    "docs:build": "vp run @yielded/sync-docs#build",
    "docs:preview": "vp run @yielded/sync-docs#preview",
    "docs:deploy": "vp run docs:build && vp exec wrangler deploy --config site/wrangler.jsonc",
    "ready": "vp run build && vp run check && vp run test && vp run release:check",
    "changeset": "changeset",
    "changeset:pre": "changeset pre",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@cloudflare/workers-types": "5.20261015.1",
    "@effect/atom-react": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0",
    "@effect/tsgo": "0.48.1",
    "@types/node": "26.6.5",
    "effect": "4.0.0",
    "effect-cf": "0.56.6",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.2.0",
    "wrangler": "4.151.0",
    "expo-sqlite": "58.0.13",
    "playwright": "1.64.1",
    "expo": "58.0.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.87.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "starlight-links-validator": "0.27.0",
    "@yielded/starlight-theme": "0.2.2",
    "alchemy": "2.0.0-beta.83",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "vitest": "5.0.4"
  },
  "trustedDependencies": [
    "@effect/tsgo-darwin-arm64",
    "@effect/tsgo-darwin-x64",
    "@effect/tsgo-linux-arm",
    "@effect/tsgo-linux-arm64",
    "@effect/tsgo-linux-x64",
    "@effect/tsgo-win32-arm64",
    "@effect/tsgo-win32-x64",
    "@typescript/typescript-aix-ppc64",
    "@typescript/typescript-darwin-arm64",
    "@typescript/typescript-darwin-x64",
    "@typescript/typescript-freebsd-arm64",
    "@typescript/typescript-freebsd-x64",
    "@typescript/typescript-linux-arm",
    "@typescript/typescript-linux-arm64",
    "@typescript/typescript-linux-loong64",
    "@typescript/typescript-linux-mips64el",
    "@typescript/typescript-linux-ppc64",
    "@typescript/typescript-linux-riscv64",
    "@typescript/typescript-linux-s390x",
    "@typescript/typescript-linux-x64",
    "@typescript/typescript-netbsd-arm64",
    "@typescript/typescript-netbsd-x64",
    "@typescript/typescript-openbsd-arm64",
    "@typescript/typescript-openbsd-x64",
    "@typescript/typescript-sunos-x64",
    "@typescript/typescript-win32-arm64",
    "@typescript/typescript-win32-x64",
    "esbuild",
    "react",
    "sharp",
    "workerd"
  ]
}
